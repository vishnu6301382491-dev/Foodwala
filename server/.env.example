# ===================================================
# FoodWala Backend Configuration Template
# Copy this file to .env and configure your secrets
# DO NOT COMMIT .env TO GITHUB
# ===================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# OTP Development Mode
# Set to true for local development / testing (logs OTP to server console, skips real SMS charges)
# Set to false in production to enforce real SMS delivery via chosen SMS provider
OTP_DEV_MODE=true

# Security Secrets
OTP_HASH_SECRET=foodwala_secure_otp_hash_secret_2026_change_in_production
JWT_SECRET=foodwala_jwt_session_signing_secret_2026_change_in_production

# SMS Provider Configuration
# Supported providers: 'console', 'twilio', 'msg91', '2factor'
SMS_PROVIDER=console

# Provider API Credentials (Required when SMS_PROVIDER != console and OTP_DEV_MODE=false)
# For Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# For MSG91:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FOODWL

# For 2Factor (India):
TWO_FACTOR_API_KEY=
