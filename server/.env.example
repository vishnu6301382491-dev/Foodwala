# =======================================================================
# FoodWala Backend Configuration Template
# 
# Copy this file to .env and configure your secrets:
#   cp server/.env.example server/.env
#
# CRITICAL: DO NOT COMMIT .env TO GITHUB (Repo is PUBLIC)
# =======================================================================

# Server Runtime & Port
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for Production CORS (comma-separated origins)
CORS_ORIGINS=https://vishnu6301382491-dev.github.io,http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=https://vishnu6301382491-dev.github.io

# =======================================================================
# MySQL Database Configuration (Single Source of Truth)
# =======================================================================
# For local development:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=fudwala
DB_CONNECTION_LIMIT=15

# Set to true for Cloud MySQL hosts that require SSL (Railway, Aiven, Render)
DB_SSL=false

# =======================================================================
# Administrator Seed Credentials
# Automatically seeds/syncs the initial admin account upon server startup
# =======================================================================
ADMIN_EMAIL=admin@foodwala.com
ADMIN_PASSWORD=change_this_secure_admin_password_in_production
ADMIN_PHONE=9876543222

# =======================================================================
# Security & Session Secrets
# =======================================================================
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_chars
OTP_HASH_SECRET=replace_with_a_long_random_otp_secret_key_minimum_32_chars

# =======================================================================
# OTP & SMS Gateway Configuration
# =======================================================================
# Set to true for local development / testing (logs OTP to server console, skips SMS fees)
# Set to false in production to enforce real SMS delivery
OTP_DEV_MODE=true

# Supported providers: 'console', 'fast2sms', 'twilio', 'msg91', '2factor'
SMS_PROVIDER=console

# Provider API Credentials (Optional: only needed if SMS_PROVIDER != console)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FOODWL

TWO_FACTOR_API_KEY=

# =======================================================================
# WhatsApp Cloud API & AI Customer Support Configuration
# =======================================================================
# Meta WhatsApp Cloud API credentials (from developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v21.0
SUPPORT_PHONE_NUMBER=918500457005

# AI Provider Configuration ('gemini' or 'openai')
# Leave AI_API_KEY blank to use FoodWala's built-in intelligent local semantic engine
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-3.8-flash
