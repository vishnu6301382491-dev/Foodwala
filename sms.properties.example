# ===================================================================
# FoodWala SMS Gateway Configuration Example
# Copy this file to 'sms.properties' and insert your Fast2SMS API key.
# ===================================================================

# Set OTP_DEV_MODE=false for real SMS delivery to user mobile numbers
# Set OTP_DEV_MODE=true to print OTP to Tomcat console
OTP_DEV_MODE=false
SMS_PROVIDER=fast2sms

# -------------------------------------------------------------------
# Fast2SMS API Authorization Key
# Obtain for FREE at: https://www.fast2sms.com/dev/api
# -------------------------------------------------------------------
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# -------------------------------------------------------------------
# Other supported providers (Optional):
# -------------------------------------------------------------------
TWO_FACTOR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
